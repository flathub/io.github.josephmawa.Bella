      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/josephmawa/Bella",
          "tag": "v0.1.13",
          "commit": "fe764781089f00dfc0065c22c90ed3a7c985b685"
        }
